#!/usr/bin/env bash
# Release committed sources to Rafael's classroom host; keys are preinstalled privately.
set -euo pipefail
cd "$(dirname "$0")/.."
git diff --quiet
git diff --cached --quiet
release=$(git rev-parse HEAD)
release_dir="/home/marvin/apps/meg/releases/$release"
# O Dell só serve e recebe cópias (fora de processamento desde 2026-10-18):
# npm ci e build rodam aqui, pelo taskctl local, e a release vai pronta.
stage="output/releases/$release"
archive="$stage.tar"
rm -rf "$stage" "$archive"
mkdir -p "$stage"
git archive --format=tar HEAD | tar -x -C "$stage"
taskctl run --block --cpus 2 --memory-mb 1024 --timeout 300 --motivo "build meg $release" -- \
  bash -c "cd '$PWD/$stage' && npm ci --no-audit --no-fund && npm run build"
tar -C "$stage" -cf "$archive" .
ssh marvin-dell "mkdir -p '$release_dir'; test -f /home/marvin/.config/whispering-sands/server.env"
scp -q "$archive" "marvin-dell:$release_dir/release.tar"
ssh marvin-dell "cd '$release_dir' && tar -xf release.tar && rm release.tar && test -f output/web/index.html"
rm -rf "$stage" "$archive"
printf 'Release staged: %s\nActivate:\n' "$release"
printf 'ssh marvin-dell "ln -sfn %s /home/marvin/apps/meg/next; mv -Tf /home/marvin/apps/meg/next /home/marvin/apps/meg/current"\n' "$release_dir"
printf "publicar-app servico meg 4317 /home/marvin/apps/meg/current -- 'env NODE_ENV=production OPENAI_ENV_FILE=/home/marvin/.config/whispering-sands/server.env ./bin/dev'\n"
printf 'PUBLICAR_DOMINIO=raffareis.com publicar-app publicar meg 4317\n'
