OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Base assets are generated separately with fixed gpt-image-2.5-sunburst.
# bin/generate-base-assets.ts reads OPENAI_ENV_FILE when supplied.
PORT=4317
HOST=127.0.0.1
# Durable room state and generated scene images; keep outside public source control.
DATA_DIR=./data
# Tiny generative helpers; independent of the DM and the image renderer.
OPENAI_WORKER_MODEL=gpt-5.4-nano
# Optional System One visual-reference selection; disabled when base URL is empty.
# Jev: https://api.typesafe.ai/v1 and jev-1.13.0.
# Local Laya-compatible service: http://127.0.0.1:8000/v1 and english.
SYSTEM_ONE_BASE_URL=
SYSTEM_ONE_MODEL=jev-1.13.0
SYSTEM_ONE_API_KEY=
# Keep shadow until evaluated on the game's own examples. false enables the choice gate.
SYSTEM_ONE_SHADOW=true
